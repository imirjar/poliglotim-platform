{
  "realm": "study",
  "enabled": true,
  "loginTheme": "poliglotim",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "rememberMe": true,
  "roles": {
    "realm": [
      {
        "name": "student",
        "description": "Student role"
      },
      {
        "name": "teacher",
        "description": "Teacher role"
      },
      {
        "name": "admin",
        "description": "Application administrator role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "web",
      "name": "Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "https://study.plyglo.com/auth/callback"
      ],
      "webOrigins": [
        "https://study.plyglo.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://study.plyglo.com/*"
      }
    },
    {
      "clientId": "native",
      "name": "Native",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "com.poliglotim.app:/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.poliglotim.app:/callback"
      }
    }
  ],
  "users": [
    {
      "username": "student1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Student",
      "lastName": "One",
      "email": "student1@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "student123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "student"
      ]
    },
    {
      "username": "teacher1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Teacher",
      "lastName": "One",
      "email": "teacher1@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "teacher123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "teacher"
      ]
    },
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "One",
      "email": "admin1@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
